#!/bin/zsh -f
# Generated by render.py from templates/devbox.j2 and config.toml. Do not edit.
#
# Start (or attach to) a development container for a folder, using Apple's
# `container` CLI. zsh because it is what macOS ships; -f skips rc files.
setopt err_exit no_unset pipe_fail

prog=${0:t}
# Absolute path with symlinks resolved; $0 means the function name inside
# functions, so capture it here.
self=${0:A}

image=${THOM_CONTAINER_IMAGE:-ghcr.io/thomwiggers/thom-container:latest}
# Profile precedence: -p, $THOM_CONTAINER_PROFILE, .thom-container-profile
# (found once DIR is known), default.
profile=${THOM_CONTAINER_PROFILE:-}
profile_file=.thom-container-profile
profiles=(private work)
state_root="$HOME/.cache/thom-containers"
key_dir="$HOME/.config/age"
known_hosts="$HOME/.ssh/known_hosts"
cpus=${THOM_CONTAINER_CPUS:-0}
memory=${THOM_CONTAINER_MEMORY:-8G}
docker=${THOM_CONTAINER_DOCKER:-}
code_bin=${THOM_CONTAINER_CODE:-code}
gh_token=1
[[ -n ${THOM_CONTAINER_NO_GH:-} ]] && gh_token=
claude_service=thom-container-claude
typeset -A github_users=(
)

usage() {
    cat <<EOF
Usage: $prog [options] [DIR] [-- COMMAND...]

Start a container with DIR (default: current directory) mounted at
/project. If a container for DIR and the profile is already
running, attach a new shell to it instead.

The profile can also be set per folder: put its name on the first line of a
$profile_file file in DIR or any parent directory.

The home directory /home/thom is persisted per profile in
$state_root/<profile>.

Options:
  -p, --profile NAME  Profile to use: ${profiles[*]} (default: private)
                      [env: THOM_CONTAINER_PROFILE, file: $profile_file]
      --attach        Attach a new shell (or run COMMAND) in the running
                      container; fail if there is none
      --code          Open VS Code on /project in the running container
                      over Remote-SSH (<name>.devbox); fail if there is none
                      [env: THOM_CONTAINER_CODE=<code command>]
      --reset         Delete the profile's persisted home and Nix store after
                      asking, so they are re-seeded from the image; refuses if any container
                      of the profile is running
      --pull          Pull the image before starting
      --self-update   Update this script (git pull if it lives in a clone,
                      otherwise download the latest release) and exit
      --docker        Grant all capabilities and start dockerd inside the
                      container (its own VM) [env: THOM_CONTAINER_DOCKER=1]
      --no-gh         Don't pass the host's \`gh auth token\` in to log in
                      to GitHub [env: THOM_CONTAINER_NO_GH=1]
      --register-claude-token
                      Store a Claude Code token (from \`claude setup-token\`,
                      signed in to the profile's account) in the Keychain and
                      exit; containers of the profile log in with it
      --image IMAGE   Image to run (default: $image) [env: THOM_CONTAINER_IMAGE]
  -c, --cpus N        CPUs for a new container; 0 = all host CPUs
                      (default: 0) [env: THOM_CONTAINER_CPUS]
  -m, --memory SIZE   Memory for a new container, e.g. 16G or 4096M
                      (default: 8G) [env: THOM_CONTAINER_MEMORY]
  -h, --help          Show this help

A running container keeps its size; exit it to start one with another.
EOF
}

die() {
    print -r -- "$prog: $*" >&2
    exit 1
}

self_update() {
    local repo=${self:h:h} tmp
    # Only when bin/devbox sits in a clone of this repo, not in any repo
    # that happens to contain ~/.local.
    if [[ -e $repo/.git && -f $repo/templates/devbox.j2 ]]; then
        print -r -- "Updating clone in $repo"
        git -C "$repo" pull --ff-only
        return
    fi
    tmp=$(mktemp)
    # In zsh, a function's EXIT trap fires as it returns, after its locals
    # are gone: expand the path now.
    trap "rm -f ${(q)tmp}" EXIT
    print -r -- "Downloading https://raw.githubusercontent.com/thomwiggers/thom-container/main/bin/devbox"
    curl -fsSL "https://raw.githubusercontent.com/thomwiggers/thom-container/main/bin/devbox" -o "$tmp"
    zsh -n "$tmp" || die "downloaded script does not parse; not replacing $self"
    if cmp -s "$tmp" "$self"; then
        print -r -- "Already up to date: $self"
        return
    fi
    # Replace via rename so the running copy isn't modified in place.
    install -m 0755 "$tmp" "$self.new"
    mv -f "$self.new" "$self"
    print -r -- "Updated $self"
}

pull=
attach=
register_claude=
open_code=
reset=
size_set=
dir=
while (( $# )); do
    case $1 in
        -p | --profile)
            (( $# >= 2 )) || die "$1 needs an argument"
            profile=$2
            shift 2
            ;;
        --attach)
            attach=1
            shift
            ;;
        --code)
            open_code=1
            shift
            ;;
        --reset)
            reset=1
            shift
            ;;
        --pull)
            pull=1
            shift
            ;;
        --self-update)
            self_update
            exit 0
            ;;
        --docker)
            docker=1
            shift
            ;;
        --no-gh)
            gh_token=
            shift
            ;;
        --register-claude-token)
            register_claude=1
            shift
            ;;
        --image)
            (( $# >= 2 )) || die "$1 needs an argument"
            image=$2
            shift 2
            ;;
        -c | --cpus)
            (( $# >= 2 )) || die "$1 needs an argument"
            cpus=$2
            size_set=1
            shift 2
            ;;
        -m | --memory)
            (( $# >= 2 )) || die "$1 needs an argument"
            memory=$2
            size_set=1
            shift 2
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*) die "unknown option: $1 (see --help)" ;;
        *)
            [[ -z $dir ]] || die "only one DIR may be given"
            dir=$1
            shift
            ;;
    esac
done

[[ $cpus == <-> ]] || die "CPUs must be a whole number (0 = all): '$cpus'"
# A bare number would be bytes.
[[ $memory == <->[KMGTkmgt] ]] || die "memory needs a unit, e.g. 16G or 4096M: '$memory'"
[[ -d ${dir:-.} ]] || die "cannot access folder: $dir"
dir=${${dir:-.}:A}

if [[ -z $profile ]]; then
    # Nearest $profile_file wins, like .git.
    d=$dir
    while true; do
        if [[ -f $d/$profile_file ]]; then
            read -r profile <"$d/$profile_file" || true
            profile=${${profile## #}%% #}
            [[ -n $profile ]] || die "$d/$profile_file is empty"
            break
        fi
        [[ $d == / ]] && break
        d=${d:h}
    done
    profile=${profile:-private}
fi

(( ${profiles[(Ie)$profile]} )) \
    || die "unknown profile '$profile' (known: ${profiles[*]}; add it to config.toml)"

register_claude_token() {
    local token
    (( $+commands[security] )) || die "'security' not found; the Claude token is kept in the macOS Keychain"
    print -r -- "Run 'claude setup-token' signed in to the account for profile '$profile'." >&2
    print -rn -- "Paste the token: " >&2
    read -rs token || token=
    print >&2
    token=${${token## #}%% #}
    [[ -n $token ]] || die "no token given"
    # It goes on security's command line below, which must stay one word.
    [[ $token != *[^A-Za-z0-9_-]* ]] || die "that does not look like a token from 'claude setup-token'"
    # Via stdin (-i), so the token doesn't show up in ps.
    print -r -- "add-generic-password -U -a $profile -s $claude_service -w $token" | security -i
    security find-generic-password -a "$profile" -s "$claude_service" >/dev/null 2>&1 \
        || die "could not store the token in the Keychain"
    print -r -- "Stored the Claude token for profile '$profile'; new containers log in with it." >&2
}

if [[ -n $register_claude ]]; then
    register_claude_token
    exit 0
fi

(( $+commands[container] )) \
    || die "Apple's 'container' CLI not found (https://github.com/apple/container)"

home_state="$state_root/$profile"
# A container volume (ext4), not a host directory: macOS file systems are
# usually case-insensitive, and the Nix store has paths differing only in
# case (terminfo/a and terminfo/A).
nix_volume="dev-$profile-nix"

# Deterministic per (profile, folder) so a second invocation attaches.
slug=${${(L)dir:t}//[^a-z0-9-]/-}
slug=${${slug[1,24]}%-}
hash=$(print -rn -- "$dir" | shasum -a 256 | cut -c1-8)
name="dev-$profile-$slug-$hash"

if [[ -n $open_code ]]; then
    [[ -z $attach && -z $reset ]] || die "--code cannot be combined with --attach or --reset"
    (( $+commands[$code_bin] )) \
        || die "'$code_bin' not found; in VS Code run 'Shell Command: Install code command in PATH'"
    container inspect "$name" >/dev/null 2>&1 \
        || die "no running container for $dir with profile '$profile'"
    exec $code_bin --remote "ssh-remote+thom@$name.devbox" /project
fi

if [[ -n $reset ]]; then
    [[ -z $attach ]] || die "--reset and --attach cannot be combined"
    # Any folder's container on this profile uses the home being deleted.
    running=(${(f)"$(container list --quiet 2>/dev/null)"})
    running=(${(M)running:#dev-$profile-*})
    (( $#running )) \
        && die "containers using profile '$profile' are running (${(j:, :)running}); exit them before --reset"
    if [[ -d $home_state ]] || container volume inspect "$nix_volume" >/dev/null 2>&1; then
        print -rn -- "Delete $home_state and volume $nix_volume (all of profile '$profile')? [y/N] "
        read -r reply || reply=
        [[ $reply == [yY]* ]] || die "aborted"
        # The Nix store goes too: the home's profile links point into it.
        rm -rf -- "$home_state"
        if container volume inspect "$nix_volume" >/dev/null 2>&1; then
            container volume delete "$nix_volume" >/dev/null \
                || die "could not delete volume $nix_volume"
        fi
        print -r -- "Reset $home_state"
    fi
fi
mkdir -p "$home_state"
container volume inspect "$nix_volume" >/dev/null 2>&1 \
    || container volume create "$nix_volume" >/dev/null \
    || die "could not create volume $nix_volume for the Nix store"
# Earlier versions kept the store in a host directory, where seeding fails
# on the case clashes; nothing uses it any more.
if [[ -d $home_state.nix ]]; then
    print -r -- "Removing the unused Nix store $home_state.nix" >&2
    chmod -R u+w "$home_state.nix" 2>/dev/null
    rm -rf -- "$home_state.nix"
fi

# Claude Code keys per-project state (sessions, memory) on the working
# directory, which is always /project. The entrypoint binds
# the directory Claude would have used for the host path over it to keep
# projects apart. Not a --volume: the runtime doesn't always mount one
# nested in the home after the home itself, hiding it half the time.
claude_project=${dir//[^A-Za-z0-9]/-}
mkdir -p "$home_state/.claude/projects/$claude_project"

tty_args=(-i)
[[ -t 0 && -t 1 ]] && tty_args=(-i -t)

# Terminals title the tab with the command line (`devbox --pull`), and
# nothing in the container replaces it, so set one ourselves (OSC 2).
[[ -t 1 ]] && print -rn -- $'\e]2;'"${dir:t} ($profile)"$'\a'

env_args=(-e "TERM=${TERM:-xterm-256color}" -e "THOM_CONTAINER_PROFILE=$profile")
[[ -n ${COLORTERM:-} ]] && env_args+=(-e "COLORTERM=$COLORTERM")

if container inspect "$name" >/dev/null 2>&1; then
    [[ -z $size_set ]] \
        || print -r -- "warning: $name is already running; --cpus and --memory only apply to a new container" >&2
    (( $# )) || set -- /usr/bin/zsh -l
    if [[ -n ${SSH_AUTH_SOCK:-} ]]; then
        env_args+=(-e SSH_AUTH_SOCK=/var/host-services/ssh-auth.sock)
    fi
    exec container exec $tty_args $env_args \
        -e HOME=/home/thom \
        --user thom --workdir /project \
        "$name" "$@"
fi

[[ -z $attach ]] || die "no running container for $dir with profile '$profile'"

if [[ -n $pull ]]; then
    container image pull "$image"
fi

if [[ $cpus == 0 ]]; then
    cpus=$(sysctl -n hw.ncpu)
fi

run_args=(
    --rm --init
    --name "$name"
    --cpus "$cpus"
    --memory "$memory"
    --volume "$home_state:/home/thom"
    --volume "$nix_volume:/run/nix-state"
    --volume "$dir:/project"
    --workdir /project
    --tmpfs /home/thom/.ssh/sockets
    --tmpfs /home/thom/.config/gh
)

if [[ -n $docker ]]; then
    run_args+=(--cap-add ALL -e THOM_CONTAINER_DOCKER=1)
else
    # `container run` has no --hostname (it is the container ID), so the
    # entrypoint sets it; that needs CAP_SYS_ADMIN, which it drops again.
    run_args+=(--cap-add CAP_SYS_ADMIN)
fi
run_args+=(-e "THOM_CONTAINER_HOSTNAME=devbox${slug:+-$slug}")
run_args+=(-e "THOM_CONTAINER_CLAUDE_PROJECT=$claude_project")

# Ship the host's terminfo entry so the container knows terminals Debian
# doesn't (e.g. xterm-ghostty, which Ghostty.app provides via $TERMINFO).
# The entrypoint compiles it into ~/.terminfo, which persists, so attaching
# with `container exec` later needs nothing.
# ($terminfo is a zsh special parameter, hence term_entry.)
if [[ -n ${TERM:-} ]] && term_entry=$(infocmp -x "$TERM" 2>/dev/null); then
    run_args+=(-e "THOM_CONTAINER_TERMINFO=$(print -rn -- "$term_entry" | base64 | tr -d '\n')")
fi

if [[ -n ${SSH_AUTH_SOCK:-} ]]; then
    run_args+=(--ssh)
else
    print -r -- "warning: SSH_AUTH_SOCK not set; not forwarding an SSH agent" >&2
fi

# The entrypoint logs in with this and unsets it before starting the shell.
if [[ -n $gh_token ]] && (( $+commands[gh] )); then
    gh_args=(auth token)
    [[ -n ${github_users[$profile]:-} ]] && gh_args+=(--user "${github_users[$profile]}")
    if token=$(gh $gh_args 2>/dev/null) && [[ -n $token ]]; then
        env_args+=(-e "THOM_CONTAINER_GH_TOKEN=$token")
    else
        print -r -- "warning: 'gh ${gh_args[*]}' failed; not logging in to GitHub" >&2
    fi
fi

# Claude Code token from --register-claude-token, if any. Not with -e, which
# would show in ps and `container inspect`: it goes in a file in a private
# directory, which the entrypoint empties on start.
claude_tmp=${${TMPDIR:-/tmp}%/}
# Tokens left by containers that never started, and emptied directories.
rm -f -- $claude_tmp/devbox-claude.*/token(N.mm+10)
rmdir -- $claude_tmp/devbox-claude.*(N/^F) 2>/dev/null || true
if (( $+commands[security] )) \
    && token=$(security find-generic-password -a "$profile" -s "$claude_service" -w 2>/dev/null) \
    && [[ -n $token ]]; then
    claude_dir=$(mktemp -d "$claude_tmp/devbox-claude.XXXXXX")
    (umask 077 && print -r -- "$token" >"$claude_dir/token")
    run_args+=(--volume "$claude_dir:/run/host-claude")
fi
unset token

# Just the file: mounting ~/.ssh would expose the private keys.
if [[ -f $known_hosts ]]; then
    run_args+=(--volume "$known_hosts:/run/host-ssh/known_hosts:ro")
fi

if [[ -f $key_dir/keys.txt ]]; then
    run_args+=(--volume "$key_dir:/run/host-age:ro")
else
    print -r -- "warning: no age key at $key_dir/keys.txt; encrypted dotfiles stay locked" >&2
fi

if [[ -n ${SSH_AUTH_SOCK:-} ]]; then
    print -r -- "ssh: thom@$name.devbox" >&2
fi

exec container run $tty_args $env_args $run_args "$image" "$@"
