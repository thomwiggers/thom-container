# syntax=docker/dockerfile:1
# {{ generated_header }}
# Two stages on a common base: `build` runs Nix, Home Manager and the Claude
# Code installer; the final image takes only their output (/nix and the
# home). Built in place, the home would ship twice, once in the layers that
# filled it and again in the seed copy, and the image's own home is hidden by
# the persistent mount anyway.
FROM {{ image.base }} AS base

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG DEBIAN_FRONTEND=noninteractive

# Base system. curl, git and xz-utils are what the Nix installer and the
# dotfiles checkout need; everything else comes from Home Manager.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      curl \
      file \
      git \
      gnupg \
      hostname \
      less \
      locales \
      ncurses-term \
      openssh-client \
      procps \
      rsync \
      sudo \
      tzdata \
      unzip \
      util-linux \
      wget \
      xz-utils \
      zsh \
 && sed -i 's/^# *\(en_US.UTF-8\)/\1/' /etc/locale.gen \
 && locale-gen \
 && rm -rf /var/lib/apt/lists/*
ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8

# Apple's container leaves no marker such as /.dockerenv; follow the systemd
# convention so tools (e.g. the dotfiles' Claude sandbox settings) can tell
# they run in a container.
ENV container=apple

# Also trust the host's known_hosts, which devbox mounts read-only. ssh keeps
# adding new hosts to the container's own ~/.ssh/known_hosts.
RUN echo 'GlobalKnownHostsFile /etc/ssh/ssh_known_hosts /etc/ssh/ssh_known_hosts2 {{ container.host_known_hosts }}' \
      > /etc/ssh/ssh_config.d/host-known-hosts.conf

# GitHub CLI from the official apt repository.
RUN install -d -m 0755 /etc/apt/keyrings \
 && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
 && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends gh \
 && rm -rf /var/lib/apt/lists/*

# Docker Engine for `devbox --docker`; dockerd is started by the entrypoint.
RUN curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc \
 && chmod go+r /etc/apt/keyrings/docker.asc \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
      > /etc/apt/sources.list.d/docker.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      containerd.io \
      docker-buildx-plugin \
      docker-ce \
      docker-ce-cli \
      docker-compose-plugin \
      iptables \
 && rm -rf /var/lib/apt/lists/*

# Browsers and drivers for Selenium. Chrome for Testing, which Selenium
# Manager downloads, has no linux-arm64 builds; Debian's chromedriver is on
# PATH, where Selenium Manager looks first. Firefox's geckodriver is left to
# Selenium Manager. fonts-liberation (metric-compatible Arial, Times, Courier)
# is only a recommendation, so name it explicitly.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      chromium \
      chromium-driver \
      firefox-esr \
      fonts-liberation \
 && rm -rf /var/lib/apt/lists/*

# Unprivileged user matching the macOS host uid/gid, with passwordless sudo.
# /nix is owned by the user: single-user Nix, no daemon.
RUN groupadd --non-unique --gid {{ user.gid }} {{ user.name }} \
 && useradd --uid {{ user.uid }} --gid {{ user.gid }} --shell {{ user.shell }} \
      --home-dir {{ container.home }} --create-home {{ user.name }} \
 && echo '{{ user.name }} ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/{{ user.name }} \
 && chmod 0440 /etc/sudoers.d/{{ user.name }} \
 && usermod -aG docker {{ user.name }} \
 && install -d -o {{ user.uid }} -g {{ user.gid }} /nix {{ container.project }}

# sshd for VS Code Remote-SSH and the like, reached as <name>.<dns_domain>
# from the Mac.
# - No host keys in the image (Debian's postinst generates some, and the image
#   is public); the entrypoint installs one that persists in the home.
# - Public keys of the forwarded agent are authorized by the entrypoint, in
#   a tmpfs file so no stale keys survive the container.
# - PAM is off, which makes sshd refuse accounts whose password field starts
#   with "!" (useradd's default); "*" is unusable as a password but not locked.
# - sshd gives sessions a bare environment; the entrypoint writes SetEnv.
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssh-server \
 && rm -rf /var/lib/apt/lists/* /etc/ssh/ssh_host_* \
 && usermod -p '*' {{ user.name }} \
 && printf '%s\n' \
      'HostKey /etc/ssh/ssh_host_ed25519_key' \
      'AuthorizedKeysFile /run/user/{{ user.uid }}/authorized_keys' \
      'AllowUsers {{ user.name }}' \
      'PermitRootLogin no' \
      'PasswordAuthentication no' \
      'KbdInteractiveAuthentication no' \
      'UsePAM no' \
      > /etc/ssh/sshd_config.d/devbox.conf

# The Nix installer wants $USER; ~/.nix-profile/bin is where nix lives.
ENV USER={{ user.name }} \
    PATH={{ container.home }}/.nix-profile/bin:{{ container.home }}/.local/bin:$PATH

FROM base AS build
USER {{ user.name }}
WORKDIR {{ container.home }}

# Nix has no build sandbox here: unprivileged user namespaces are not
# available while building the image or in the container.
RUN install -d ~/.config/nix \
 && printf 'experimental-features = nix-command flakes\nsandbox = false\n' > ~/.config/nix/nix.conf \
 && curl -fsSL https://nixos.org/nix/install | sh -s -- --no-daemon \
 && nix --version

# Dotfiles built without the age key: the secrets module skips decryption
# when ~/.config/age/keys.txt is missing. `-b` moves aside the skeleton files
# useradd created. DOTFILES_HASH is a hash of the flake's inputs (see
# dotfiles.cache_paths), so this slow layer is only rebuilt when they change.
ARG DOTFILES_HASH=unknown
RUN echo "dotfiles hash: ${DOTFILES_HASH}" \
 && git clone {{ dotfiles.repo }} "$HOME/{{ dotfiles.dir }}" \
 && nix run "$HOME/{{ dotfiles.dir }}#home-manager" -- switch \
      --flake "$HOME/{{ dotfiles.dir }}#{{ dotfiles.config }}" -b hm-bak

# Claude Code, native installer. CLAUDE_CACHE_BUST lets CI pick up new
# releases without rebuilding the (slow) dotfiles layer.
ARG CLAUDE_CACHE_BUST=unknown
RUN echo "claude cache bust: ${CLAUDE_CACHE_BUST}" \
 && curl -fsSL https://claude.ai/install.sh | bash \
 && claude --version

# Markers for the entrypoint. Nothing here may differ between builds of the
# same inputs (no commit or run id): the home becomes one layer of the final
# image, and a new digest for it means devices pulling it all again.
# .thom-container-image says the home is seeded.
# .thom-container-nix identifies the /nix contents: the dotfiles hash changes
# exactly when the Home Manager layer is rebuilt, so it stays put across
# rebuilds that leave the store alone (a local build without DOTFILES_HASH
# falls back to a hash of the store's contents).
RUN echo "${DOTFILES_HASH} ${CLAUDE_CACHE_BUST}" > .thom-container-image \
 && if [ "${DOTFILES_HASH}" = unknown ]; then nix_id=$(ls /nix/store | sha256sum | cut -d' ' -f1); else nix_id=${DOTFILES_HASH}; fi \
 && echo "${nix_id}" > .thom-container-nix

FROM base
# The store, then the home as the seed: the real home is a persistent host
# mount, which the entrypoint seeds from this copy on first start. COPY
# --from doesn't keep the owner.
COPY --from=build --chown={{ user.uid }}:{{ user.gid }} /nix /nix
COPY --from=build --chown={{ user.uid }}:{{ user.gid }} {{ container.home }} {{ container.home_seed }}

# The image's own home gets the Nix state (links only), so `nix` works when
# the image is run without the entrypoint or the home mount.
USER {{ user.name }}
RUN cd {{ container.home_seed }} \
 && for p in {% for d in container.nix_state %}"{{ d }}" {% endfor %}; do \
      if [ -e "$p" ] || [ -L "$p" ]; then cp -a --parents "$p" {{ container.home }}/; fi; \
    done \
 && nix --version
USER root

COPY --chmod=0755 entrypoint.sh /usr/local/bin/entrypoint

WORKDIR {{ container.project }}
ENTRYPOINT ["/usr/local/bin/entrypoint"]
CMD ["{{ user.shell }}", "-l"]
