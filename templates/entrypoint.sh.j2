#!/bin/bash
# {{ generated_header }}
#
# Runs as root: seeds the persistent home directory, fixes up the forwarded
# SSH agent socket, then re-executes itself as {{ user.name }} to finish the
# dotfiles install and exec the requested command.
set -euo pipefail

user_name={{ user.name }}
user_uid={{ user.uid }}
user_gid={{ user.gid }}
home_dir={{ container.home }}
home_seed={{ container.home_seed }}
key_src={{ container.key_dir }}/{{ container.key_file }}
dotfiles_dir=$home_dir/{{ dotfiles.dir }}
authorized_keys=/run/user/$user_uid/authorized_keys
marker=.thom-container-image

log() { echo "entrypoint: $*" >&2; }

root_stage() {
    chown "$user_uid:$user_gid" "$home_dir" 2>/dev/null || true

    # Keep gpg-agent & co. from putting sockets in the virtiofs home.
    install -d -m 0700 -o "$user_uid" -g "$user_gid" "/run/user/$user_uid"

    # Per-container tmpfs mounts under home come up owned by root.
{% for d in container.ephemeral %}
    if [ -d "$home_dir/{{ d }}" ]; then
        chown "$user_uid:$user_gid" "$home_dir/{{ d }}"
        chmod 0700 "$home_dir/{{ d }}"
    fi
{% endfor %}

    if [ -n "${THOM_CONTAINER_HOSTNAME:-}" ]; then
        if hostname "$THOM_CONTAINER_HOSTNAME" 2>/dev/null; then
            printf '127.0.1.1\t%s\n' "$THOM_CONTAINER_HOSTNAME" >>/etc/hosts 2>/dev/null \
                || log "warning: could not add $THOM_CONTAINER_HOSTNAME to /etc/hosts"
        else
            log "warning: could not set hostname to $THOM_CONTAINER_HOSTNAME"
        fi
    fi
    unset THOM_CONTAINER_HOSTNAME

    # The launcher only adds CAP_SYS_ADMIN for the hostname; --docker needs
    # everything it grants.
    local -a cap_args=()
    if [ -n "${THOM_CONTAINER_DOCKER:-}" ]; then
        start_dockerd
    else
        cap_args=(--bounding-set=-sys_admin)
    fi

    # Same bounding set as the shell, so ssh sessions can't use SYS_ADMIN.
    start_sshd "${cap_args[@]}" || log "warning: sshd did not start; no ssh access"

    # Apple container's --ssh mounts the agent socket owned by root.
    if [ -n "${SSH_AUTH_SOCK:-}" ] && [ -S "$SSH_AUTH_SOCK" ]; then
        chown "$user_uid:$user_gid" "$SSH_AUTH_SOCK" 2>/dev/null \
            || chmod 0666 "$SSH_AUTH_SOCK" 2>/dev/null \
            || log "warning: could not make $SSH_AUTH_SOCK accessible"
    fi

    # Not exec'd: when the command ends, stay up while ssh sessions (VS Code
    # Remote-SSH) are open, since the container ends with this process. With
    # a terminal, job control gives the command its own process group and
    # takes the terminal back afterwards, so Ctrl-C reaches us again.
    [ -t 0 ] && set -m
    local status=0
    setpriv --reuid="$user_uid" --regid="$user_gid" --init-groups "${cap_args[@]}" \
        env HOME="$home_dir" USER="$user_name" LOGNAME="$user_name" SHELL={{ user.shell }} \
        "$0" --user-stage "$@" || status=$?
    if ssh_sessions; then
        log "command exited ($status); staying up while ssh sessions are open (Ctrl-C to stop)"
        while ssh_sessions; do sleep 2; done
    fi
    exit "$status"
}

# Whether $user_name has an ssh session: sshd's per-session processes are
# titled "sshd: user [priv]" and "sshd: user@pts/0" (or @notty).
ssh_sessions() {
    pgrep -f "sshd: $user_name(@| \\[)" >/dev/null
}

# sshd, for Remote-SSH from the Mac. Arguments: a setpriv prefix, if any.
start_sshd() {
    local keys=$home_dir/{{ container.sshd_keys }} key=/etc/ssh/ssh_host_ed25519_key
    local -a launch=()
    [ $# -eq 0 ] || launch=(setpriv "$@")

    # The host key persists in the home so the Mac's known_hosts stays valid.
    mkdir -p "$keys" /run/sshd
    if [ ! -s "$keys/ssh_host_ed25519_key" ]; then
        rm -f "$keys/ssh_host_ed25519_key" "$keys/ssh_host_ed25519_key.pub"
        ssh-keygen -q -t ed25519 -N '' -C "devbox" -f "$keys/ssh_host_ed25519_key"
        chown -R "$user_uid:$user_gid" "$keys" 2>/dev/null || true
    fi
    install -m 0600 "$keys/ssh_host_ed25519_key" "$key"
    install -m 0644 "$keys/ssh_host_ed25519_key.pub" "$key.pub"

    # sshd starts sessions with a bare environment; pass what the image's
    # ENV and the launcher set. (Only the first SetEnv line counts, so write
    # one.) None of the values contain spaces.
    local var env_line=
    for var in container LANG LC_ALL PATH SSH_AUTH_SOCK THOM_CONTAINER_PROFILE; do
        [ -z "${!var:-}" ] || env_line="$env_line $var=${!var}"
    done
    echo "SetEnv$env_line" > /etc/ssh/sshd_config.d/zz-session-env.conf

    "${launch[@]}" /usr/sbin/sshd
}

start_dockerd() {
    # Needs the extra capabilities that `devbox --docker` grants.
    mount -o remount,rw /sys/fs/cgroup 2>/dev/null || true
    log "starting dockerd (log: /var/log/dockerd.log)"
    dockerd >/var/log/dockerd.log 2>&1 &
    for _ in $(seq 1 30); do
        [ -S /var/run/docker.sock ] && return 0
        sleep 0.5
    done
    log "warning: dockerd did not come up; see /var/log/dockerd.log"
}

user_stage() {
    local image_id home_id agent_keys
    if [ ! -e "$home_dir/$marker" ]; then
        # As the user, so the copy works on a mount that refuses chown.
        log "seeding $home_dir from image (existing files are kept)"
        # Copy the entries, not "$home_seed/.": that would also copy the
        # seed's times and mode onto the home mount point, which the user
        # doesn't own. Attribute errors on dirs the runtime created for
        # nested mounts (e.g. ~/.ssh) shouldn't stop the container either.
        (
            shopt -s dotglob nullglob
            set -- "$home_seed"/*
            [ $# -eq 0 ] || cp -a --update=none "$@" "$home_dir/"
        ) || log "warning: some files could not be copied completely; continuing"
    fi

    image_id=$(cat "$home_seed/$marker" 2>/dev/null || echo unknown)
    home_id=$(cat "$home_dir/$marker" 2>/dev/null || echo none)
    if [ "$image_id" != "$home_id" ]; then
        # New image: /nix came from the image, so the profile links in the
        # persisted home point at store paths that no longer exist. Take the
        # image's links; the switch below relinks the rest.
        log "image changed ($home_id -> $image_id); refreshing Nix profiles"
        local p
        for p in {% for d in container.nix_state %}"{{ d }}" {% endfor %}; do
            rm -rf "${home_dir:?}/$p"
            if [ -e "$home_seed/$p" ] || [ -L "$home_seed/$p" ]; then
                mkdir -p "$(dirname "$home_dir/$p")"
                cp -a "$home_seed/$p" "$home_dir/$p" || log "warning: could not refresh $p"
            fi
        done
        echo "$image_id" > "$home_dir/$marker"
    fi

    # Which devbox profile this home belongs to, for prompts and scripts.
    export THOM_CONTAINER_PROFILE=${THOM_CONTAINER_PROFILE:-unknown}

    # sshd (root stage) authorizes the public keys of the forwarded agent.
    if [ -n "${SSH_AUTH_SOCK:-}" ] && agent_keys=$(ssh-add -L 2>/dev/null); then
        printf '%s\n' "$agent_keys" > "$authorized_keys"
        chmod 0600 "$authorized_keys"
    else
        log "warning: no keys in the SSH agent; cannot ssh into this container"
    fi

    # Terminfo entry for the host terminal (base64 of `infocmp -x $TERM`).
    if [ -n "${THOM_CONTAINER_TERMINFO:-}" ]; then
        if ! printf '%s' "$THOM_CONTAINER_TERMINFO" | base64 -d \
            | tic -x -o "$home_dir/.terminfo" - 2>/dev/null; then
            log "warning: could not install terminfo for $TERM"
        fi
        unset THOM_CONTAINER_TERMINFO
    fi

    # GitHub token from the host's gh. Logging in stores it in ~/.config/gh
    # (a tmpfs); the dotfiles already use gh as git's credential helper.
    if [ -n "${THOM_CONTAINER_GH_TOKEN:-}" ]; then
        local gh_token=$THOM_CONTAINER_GH_TOKEN
        unset THOM_CONTAINER_GH_TOKEN
        if ! printf '%s\n' "$gh_token" | gh auth login --hostname github.com --with-token; then
            log "warning: gh auth login failed; run it by hand"
        fi
        unset gh_token
    fi

    # Link to the host's key rather than copying it into the persisted home.
    # Without it, the dotfiles' secrets module skips decryption.
    local key_link="$home_dir/{{ container.key_link }}"
    if [ -f "$key_src" ]; then
        mkdir -p "$(dirname "$key_link")"
        ln -sfn "$key_src" "$key_link"
    else
        rm -f "$key_link"
        log "no age key at $key_src; skipping encrypted dotfiles"
    fi

    if [ -z "${THOM_CONTAINER_SKIP_APPLY:-}" ]; then
        # Pull the dotfiles and switch, overwriting local edits to managed
        # files. If the pull fails (e.g. offline), still switch to what we
        # have, without fetching. Failures should not keep the shell from
        # starting.
        local -a switch_args=()
        if ! git -C "$dotfiles_dir" pull --ff-only </dev/null; then
            log "warning: dotfiles pull failed; switching without pulling"
            switch_args=(--offline)
        fi
        if ! nix run "$dotfiles_dir#home-manager" -- switch \
            --flake "$dotfiles_dir#{{ dotfiles.config }}" -b hm-bak \
            "${switch_args[@]}" </dev/null; then
            log "warning: home-manager switch failed; continuing (rerun: home-manager switch)"
        fi
    fi

    exec "$@"
}

if [ "${1:-}" = "--user-stage" ]; then
    shift
    user_stage "$@"
elif [ "$(id -u)" = 0 ]; then
    root_stage "$@"
else
    user_stage "$@"
fi
